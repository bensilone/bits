{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Sparks capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" },
        { "url": "http://127.0.0.1:8787" },
        { "url": "http://127.0.0.1:8787/*" },
        { "url": "http://localhost:8787" },
        { "url": "http://localhost:8787/*" }
      ]
    }
  ]
}
